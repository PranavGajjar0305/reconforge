#!/usr/bin/env python3
"""Lab stand-in for a passive subdomain tool (demonstrates registry-driven integration).
Prints hostnames in a mixed, tool-like format; ReconForge's generic parser extracts them."""
import sys

if "--version" in sys.argv:
    print("lab-subenum 1.0.0")
    sys.exit(0)
domain = sys.argv[-1]
print(f"[source:lab-dataset] cdn-origin.{domain}")
print(f"api.{domain} (FQDN) --> a_record --> 127.0.0.1 (IPAddress)")
print(f"unrelated.example.org")
